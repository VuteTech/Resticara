[Unit]
Description=Resticara prune for b2:example-bucket:website/
Wants=network-online.target
After=network-online.target resticara-backup.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/resticara --config=/etc/resticara/config.ini prune b2:example-bucket:website/
EnvironmentFile=-/etc/resticara/restic.env
Environment=RESTIC_CACHE_DIR=/var/cache/resticara
CacheDirectory=resticara

[Install]
WantedBy=multi-user.target
