; Restic credentials (RESTIC_PASSWORD, B2_ACCOUNT_ID, B2_ACCOUNT_KEY, ...) are not stored here:
; put them in restic.env next to this file, it is loaded by the units created with `resticara gentimer`.

[general]
; if hostID=hostname, the actual hostname of the machine will be shown
hostID=hostname
retention_prune = 14
;; excludes in [general] apply to every dir job
;exclude = *.tmp
;exclude_caches = true

[smtp]
enabled = false
;from = "user@example.com"
;username = "user@example.com"
;pass = "#################3"
;to = "admin@example.com"
;server = "mail.example.com"
;; 587 uses STARTTLS, 465 uses implicit TLS
;port = "587"

[matrix]
enabled = false
;server = "https://matrix.example.com"
;username = "@bot:example.com"
;pass = "#################"
;; alternatively use an access token instead of username/pass
;access_token = "syt_..."
;room_id = "!abcdefg:example.com"

[telegram]
enabled = false
;bot_token = "123456:ABCDEF"
;chat_id = 123456789

[dir:website]
bucket = b2:bucket:wpsites/
; one line per directory
directory = /var/www
directory = /etc/nginx
;; one line per pattern; see the README for exclude_file and exclude_if_present
;exclude = wp-content/cache
;exclude = wp-content/upgrade
retention_daily = 4
retention_weekly = 7
retention_monthly = 3
retention_prune = 14

[mysql:maindb]
bucket = b2:bucket:mariadb/
; a database name, or mysqldump options such as --all-databases or --databases db1 db2
database = --all-databases
; extra mysqldump options, added after --single-transaction
;mysqldump_args = --routines --events
retention_daily = 4
retention_weekly = 7
retention_monthly = 3
